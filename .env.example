# Локальная конфигурация плагина cxbox-plugin-atlassian (локальная разработка и тесты).
#
# Как пользоваться:
#   1. скопируйте этот файл в .env          -> cp .env.example .env
#   2. заполните значения своими
#   3. .env добавлен в .gitignore и в репозиторий не попадёт
#
# ./gradlew runIde и ./gradlew test подхватывают .env автоматически и передают
# значения в запускаемый процесс IDE/тестов. Переменные окружения имеют приоритет
# над настройками, сохранёнными в Settings -> Tools (файл .idea/cxbox-atlassian.xml),
# поэтому удобно гонять плагин против тестового пространства Confluence.
#
# Те же переменные можно выставить в окружении вручную (CI, терминал), без файла .env.

# Базовый URL Confluence, без завершающего слэша (обязательно)
CXBOX_CONFLUENCE_URL=https://confluence.example.com

# Режим аутентификации: bearer (по умолчанию) или basic
#   bearer -> Authorization: Bearer <token>             — Personal Access Token, Server/DC
#   basic  -> Authorization: Basic base64(email:token)  — API-токен, Confluence Cloud
CXBOX_CONFLUENCE_AUTH=bearer

# Email — нужен ТОЛЬКО для режима basic (Confluence Cloud).
# В режиме bearer игнорируется, можно оставить пустым.
CXBOX_CONFLUENCE_EMAIL=

# Personal Access Token (bearer) или API-токен Cloud (basic) — обязательно
CXBOX_CONFLUENCE_TOKEN=

# Ключ пространства, в которое публикуется документация (обязательно)
CXBOX_CONFLUENCE_SPACE_KEY=DEV

# Необязательно: ID родительской страницы для создаваемой документации
CXBOX_CONFLUENCE_PARENT_PAGE_ID=
